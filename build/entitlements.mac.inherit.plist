<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The four helper processes (GPU, Plugin, Renderer, and the bare helper)
         are signed with this file rather than the main one. Omitting it fails
         differently from omitting the main file and is easy to misread: the app
         signs, launches, and then the renderers die. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
