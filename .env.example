# Copy this file to .env before running `npm run dev` or `npm run dist:win`.
# These two values are baked into the app at BUILD time (see the `define`
# block in electron.vite.config.ts) — there is no in-app Settings field for
# them, and no runtime way for a user to see or change them. Only whoever
# builds the app controls this.

# The deployed Tracely Relay URL (see ../Tracely-relay/README.md). Example:
# https://tracely-relay-yourname.vercel.app
RELAY_URL=

# Must match APP_SHARED_TOKEN set on the relay's Vercel environment.
RELAY_TOKEN=

# Optional. Semantic Scholar works without a key at low rate limits; supply
# one for higher throughput. This one IS user-editable via in-app Settings —
# it's not a cost/security concern like the AI relay credentials above.
SEMANTIC_SCHOLAR_API_KEY=

# Supabase project for real user accounts (Settings > Data API in the
# Supabase dashboard). The anon key is safe to bake in — it is not secret,
# access control is enforced by Row-Level Security policies in Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
