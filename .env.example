# Copy this file to .env before running `npm run dev` or `npm run dist:win`.
# These two values are baked into the app at BUILD time (see the `define`
# block in electron.vite.config.ts) — there is no in-app Settings field for
# them, and no runtime way for a user to see or change them. Only whoever
# builds the app controls this.

# The deployed Tracely Relay URL (see ../Tracely-relay/README.md). Example:
# https://tracely-relay-yourname.vercel.app
RELAY_URL=

# Must match APP_SHARED_TOKEN set on the relay's Vercel environment.
RELAY_TOKEN=

# Optional. Unlike the two above, these are read at RUNTIME (config.json in
# the app data dir, falling back to this file), not baked in at build time.
# Neither is a cost or security concern like the relay credentials — both are
# free and rate-limit-scoped rather than billed.

# Semantic Scholar's keyless tier is one pool shared across every anonymous
# caller worldwide, so it answers 429 most of the time. A key gives a
# dedicated 1 req/sec. Apply at semanticscholar.org/product/api#api-key-form.
SEMANTIC_SCHOLAR_API_KEY=

# NCBI/PubMed meters by IP without a key — shared with everyone behind the
# same school or library gateway. A key meters against the key instead and
# raises the ceiling from ~3 to ~10 req/sec. Free and instant from an NCBI
# account: Account Settings > API Key Management.
NCBI_API_KEY=

# Supabase project for real user accounts (Settings > Data API in the
# Supabase dashboard). The anon key is safe to bake in — it is not secret,
# access control is enforced by Row-Level Security policies in Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
