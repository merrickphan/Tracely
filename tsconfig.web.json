{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // Same reason as tsconfig.node.json, which carries the full note: a module
    // that value-imports a sibling by relative path AND has a .test.ts beside
    // it must spell that import with an explicit `.ts`, because `npm test` runs
    // it through node --test as real ESM and Node does not guess extensions.
    //
    // It is needed here too because both configs compile `src/shared/**/*`, so
    // a tested shared module is in this program as well — without the flag,
    // `shared/citationScope.ts` typechecks under main and fails under the
    // renderer, for an import Node requires. Safe for the same reason: `noEmit`
    // is on and the real build goes through electron-vite.
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/index.d.ts"],
  // `npm test` runs these directly through Node's type stripping. Typechecking
  // them here would mean adding "node" to `types` above, which drags Node's
  // globals into the renderer program and degrades inference across every
  // renderer file — the same trap CLAUDE.md documents for importing the preload
  // implementation. The modules under test are still typechecked; the tests are
  // not.
  "exclude": ["src/**/*.test.ts"]
}
